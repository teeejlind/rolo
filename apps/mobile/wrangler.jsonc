{
  "name": "transito-bogota",
  "main": "./cloudflare-proxy.js",
  "compatibility_date": "2026-03-16",
  "vars": {
    "API_ORIGIN": "https://females-selecting-relative-bon.trycloudflare.com"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
