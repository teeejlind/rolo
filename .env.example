# Root app settings
NODE_ENV=development
PORT=4000

# For a physical iPhone dev build, replace localhost with your computer's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# Transit feeds
BOGOTA_GTFS_STATIC_URL=
BOGOTA_GTFS_RT_VEHICLE_POSITIONS=https://gis.transmilenio.gov.co/gtfs/vehiclepos.pb
BOGOTA_GTFS_RT_SERVICE_ALERTS=https://gis.transmilenio.gov.co/gtfs/serviceAlerts.pb
BOGOTA_GTFS_RT_TRIP_UPDATES=https://gis.transmilenio.gov.co/gtfs/tripupdate.pb

# Local infrastructure
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/transito_bogota
REDIS_URL=redis://localhost:6379
OTP_BASE_URL=http://localhost:8080

# Future geocoding provider
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAPBOX_ACCESS_TOKEN=
